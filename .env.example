# ==============================================================================
# BOOKMYSHOW MONOREPO - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# In accordance with Section 130: Never commit production credentials to Git.
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookmyshow?schema=public"

# Redis (Coordination locks, Caching, BullMQ)
REDIS_URL="redis://localhost:6379"

# API Port & Host
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"

# Authentication & JWT Secrets
JWT_SECRET="your_jwt_access_secret_key_min_32_characters"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_min_32_characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateway (Stripe Test Mode)
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# Object Storage (Cloudinary or AWS S3)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Frontend Public URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
